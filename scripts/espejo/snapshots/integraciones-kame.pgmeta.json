    "format": "uuid",
    "type": "uuid",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "holding_id",
    "data_type": "uuid",
    "format": "uuid",
    "type": "uuid",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "active_environment",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "updatable"
    ],
    "default_value": "'pruebas'::text",
    "comment": "Ambiente al que se envía: pruebas o produccion"
   },
   {
    "name": "enabled",
    "data_type": "boolean",
    "format": "bool",
    "type": "boolean",
    "options": [
     "updatable"
    ],
    "default_value": "false",
    "comment": "Conexión de la compañía activa: apagada no se encola ni se envía nada"
   },
   {
    "name": "send_invoices",
    "data_type": "boolean",
    "format": "bool",
    "type": "boolean",
    "options": [
     "updatable"
    ],
    "default_value": "false",
    "comment": "Registrar en Kame las facturas emitidas en Sapira"
   },
   {
    "name": "send_journal",
    "data_type": "boolean",
    "format": "bool",
    "type": "boolean",
    "options": [
     "updatable"
