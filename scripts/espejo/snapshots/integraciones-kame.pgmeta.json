   {
    "name": "journal_from",
    "data_type": "date",
    "format": "date",
    "type": "date",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Primer mes (día 1) cuyos asientos se envían"
   },
   {
    "name": "updated_by",
    "data_type": "uuid",
    "format": "uuid",
    "type": "uuid",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Usuario (public.users.id) que la cambió por última vez"
   },
   {
    "name": "created_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "type": "timestamp with time zone",
    "options": [
     "updatable"
    ],
    "default_value": "now()"
   },
   {
    "name": "updated_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "type": "timestamp with time zone",
    "options": [
     "updatable"
    ],
    "default_value": "now()"
   }
  ],
