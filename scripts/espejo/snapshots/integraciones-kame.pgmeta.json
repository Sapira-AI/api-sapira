{
 "kame_connections": {
  "name": "public.kame_connections",
  "rls_enabled": true,
  "rows": 1,
  "columns": [
   {
    "name": "id",
    "data_type": "uuid",
    "format": "uuid",
    "type": "uuid",
    "options": [
     "updatable"
    ],
    "default_value": "gen_random_uuid()"
   },
   {
    "name": "holding_id",
    "data_type": "uuid",
    "format": "uuid",
    "type": "uuid",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "company_id",
    "data_type": "uuid",
    "format": "uuid",
    "type": "uuid",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "environment",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "updatable"
    ],
    "comment": "pruebas (empresa de pruebas de Kame) o produccion (la empresa real)"
   },
   {
    "name": "client_id",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "updatable"
    ],
    "comment": "Client ID de la API de Kame (datos de empresa en Kame)"
   },
   {
    "name": "client_secret_encrypted",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "updatable"
    ],
    "comment": "Client secret cifrado con EncryptionService (iv:hex). Nunca se devuelve al front"
   },
   {
    "name": "user_email",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "updatable"
    ],
    "comment": "Correo de un usuario de la empresa en Kame: va en el campo Usuario de cada envío"
   },
   {
    "name": "kame_company_rut",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "updatable"
    ],
    "comment": "RUT de la empresa en Kame (sin puntos, con guion): resguardo contra enviar a otra empresa"
   },
   {
    "name": "business_unit",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Unidad de negocio de Kame (centro de costo) para las líneas de venta y los asientos"
   },
   {
    "name": "branch",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Sucursal de Kame; vacía = casa matriz"
   },
   {
    "name": "tested_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "type": "timestamp with time zone",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Última prueba de conexión exitosa"
   },
   {
    "name": "test_error",
    "data_type": "text",
    "format": "text",
    "type": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Error de la última prueba de conexión (null si salió bien)"
   },
   {
    "name": "updated_by",
    "data_type": "uuid",
    "format": "uuid",
    "type": "uuid",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Usuario (public.users.id) que la cambió por última vez"
   },
   {
    "name": "created_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "type": "timestamp with time zone",
    "options": [
     "updatable"
    ],
    "default_value": "now()"
   },
   {
    "name": "updated_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "type": "timestamp with time zone",
    "options": [
     "updatable"
    ],
    "default_value": "now()"
   }
  ],
  "primary_keys": [
   "id"
  ],
  "foreign_key_constraints": [
   {
    "name": "kame_connections_company_id_fkey",
    "source_table": "public.kame_connections",
    "source_columns": [
     "company_id"
    ],
    "target_table": "public.companies",
    "target_columns": [
     "id"
    ]
   },
   {
    "name": "kame_connections_holding_id_fkey",
    "source_table": "public.kame_connections",
    "source_columns": [
     "holding_id"
    ],
    "target_table": "public.company_holdings",
    "target_columns": [
     "id"
    ]
   }
  ]
 },
 "kame_company_settings": {
  "name": "public.kame_company_settings",
