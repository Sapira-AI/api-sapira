    "expr": "system = ANY (ARRAY['kame'::text])"
   },
   {
    "name": "erp_exports_target_check",
    "type": "c",
    "expr": "((object = 'invoice'::text) AND (invoice_id IS NOT NULL) AND (period IS NULL)) OR ((object = 'journal'::text) AND (invoice_id IS NULL) AND (period IS NOT NULL))"
   }
  ],
  "indexes": [
