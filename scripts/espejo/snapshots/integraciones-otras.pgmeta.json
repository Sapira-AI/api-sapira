     "partner_mapping",
     "custom_function",
     "value_mapping"
    ],
    "comment": "Tipo de transformación a aplicar al valor del campo durante la integración"
   },
   {
    "name": "transformation_config",
    "data_type": "jsonb",
    "format": "jsonb",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Configuración JSON para la transformación (tabla, columnas, filtros, etc.)"
