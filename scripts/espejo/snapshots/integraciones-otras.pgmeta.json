    "name": "secondary_target_table",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Tabla destino secundaria para mapeos jerárquicos (ej: invoice_items_legacy)"
   },
   {
    "name": "transformation_type",
