    "data_type": "character varying",
    "format": "varchar",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Tipo de item : Fijo, Variable, Licencias, Servicios, Hardware, etc."
   },
   {
    "name": "unit_of_measure",
    "data_type": "character varying",
    "format": "varchar",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Unidad de medida: USUARIOS, HORAS, PERIODOS, MESES, DÍAS, UND"
   },
   {
    "name": "unit_price",
    "data_type": "numeric",
    "format": "numeric",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Precio unitario final por unidad de medida"
   },
