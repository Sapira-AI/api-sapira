    "name": "quantity",
    "data_type": "numeric",
    "format": "numeric",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Cantidad de unidades"
   },
   {
    "name": "account",
    "data_type": "character varying",
    "format": "varchar",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Cuenta contable asociada al item"
   },
   {
    "name": "custom_fields",
    "data_type": "jsonb",
    "format": "jsonb",
    "options": [
     "nullable",
     "updatable"
    ],
    "default_value": "'{}'::jsonb",
    "comment": "Campos personalizados en formato JSON. Incluye: fuente_de_unidad, tipo_de_agregacion, fuente_optimizaciones, price_list_type, min_quantity, cutoff_date"
   },
   {
    "name": "quote_item_number",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Número de línea del item (renombrado desde salesforce_line_item_id)"
   },
   {
    "name": "data_source",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Fuente de datos del item"
   },
   {
    "name": "salesforce_product_id",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Product2.Id original de Salesforce para tracking y debugging"
   },
   {
    "name": "salesforce_line_item_id",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ]
   },
   {
    "name": "monthly_price",
    "data_type": "numeric",
    "format": "numeric",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Precio mensual del item (final_price para recurrentes). INCLUYE descuentos aplicados."
   },
   {
    "name": "billing_period_price",
    "data_type": "numeric",
    "format": "numeric",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Precio por periodo de facturación. Para recurrentes: monthly_price × frequency_multiplier. Para one-times: (final_price/term_months) × frequency_multiplier."
   },
   {
    "name": "auto_renew",
    "data_type": "boolean",
    "format": "bool",
    "options": [
     "updatable"
    ],
    "default_value": "false",
    "comment": "Indica si este item debe renovarse automáticamente al vencer"
   },
   {
    "name": "auto_renew_term_months",
    "data_type": "integer",
    "format": "int4",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Término en meses para la renovación automática. Si es NULL, usa el mismo term_months del item original"
   },
   {
    "name": "annual_unit_price",
    "data_type": "numeric",
    "format": "numeric",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Precio unitario anual. Fuente de verdad cuando price_entry_mode = annual. Derivado (unit_price * 12) cuando mode = monthly."
   },
   {
    "name": "annual_price",
    "data_type": "numeric",
    "format": "numeric",
    "options": [
     "nullable",
     "updatable"
    ],
    "comment": "Subtotal anual = annual_unit_price * quantity. Usado para totales anuales sin redondeo."
   },
   {
    "name": "price_entry_mode",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ],
    "default_value": "'monthly'::text",
    "check": "price_entry_mode = ANY (ARRAY['monthly'::text, 'annual'::text])",
    "comment": "Indica cual campo es fuente de verdad: monthly (unit_price) o annual (annual_unit_price). Default: monthly."
   }
