{
 "stripe_connections": {
  "name": "public.stripe_connections",
  "rls_enabled": true,
  "rows": 1,
  "comment": "Almacena las credenciales de conexión a Stripe por holding",
  "columns": [
   {
    "name": "id",
    "data_type": "uuid",
    "format": "uuid",
    "options": [
     "updatable"
    ],
    "default_value": "gen_random_uuid()"
   },
   {
    "name": "holding_id",
    "data_type": "uuid",
    "format": "uuid",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "user_id",
    "data_type": "uuid",
    "format": "uuid",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "name",
    "data_type": "text",
    "format": "text",
    "options": [
     "updatable"
    ]
   },
   {
    "name": "secret_key",
    "data_type": "text",
    "format": "text",
    "options": [
     "updatable"
    ],
    "comment": "Secret Key de Stripe (debe estar encriptada en producción)"
   },
   {
    "name": "publishable_key",
    "data_type": "text",
    "format": "text",
    "options": [
     "nullable",
     "updatable"
    ]
   },
   {
    "name": "mode",
    "data_type": "text",
    "format": "text",
    "options": [
     "updatable"
    ],
    "default_value": "'test'::text",
    "check": "mode = ANY (ARRAY['test'::text, 'live'::text])",
    "comment": "Modo de operación: test o live"
   },
   {
    "name": "is_active",
    "data_type": "boolean",
    "format": "bool",
    "options": [
     "nullable",
     "updatable"
    ],
    "default_value": "true"
   },
   {
    "name": "last_sync_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "options": [
     "nullable",
     "updatable"
    ]
   },
   {
    "name": "created_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "options": [
     "nullable",
     "updatable"
    ],
    "default_value": "now()"
   },
   {
    "name": "updated_at",
    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "options": [
     "nullable",
     "updatable"
    ],
    "default_value": "now()"
   }
  ],
  "primary_keys": [
   "id"
  ],
  "foreign_key_constraints": [
   {
    "name": "subscriptions_connection_id_fkey",
    "source_table": "public.subscriptions",
    "source_columns": [
     "connection_id"
    ],
    "target_table": "public.stripe_connections",
    "target_columns": [
     "id"
    ]
   }
  ]
 },
