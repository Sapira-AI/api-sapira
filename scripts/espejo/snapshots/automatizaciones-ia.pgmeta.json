    "data_type": "timestamp with time zone",
    "format": "timestamptz",
    "options": [
     "updatable"
    ],
    "default_value": "now()"
   },
   {
    "name": "created_by",
    "data_type": "uuid",
    "format": "uuid",
    "options": [
     "nullable",
     "updatable"
    ]
   }
  ],
  "primary_keys": [
   "id"
  ],
  "foreign_key_constraints": [
