    "precision": 5,
    "scale": 2
   },
   "subtotal": {
    "precision": 15,
    "scale": 2
   },
   "allocated_invoice_currency": {
    "precision": 15,
    "scale": 2
   },
   "subtotal_contract_currency": {
    "precision": 15,
    "scale": 2
   },
   "fx_contract_to_invoice": {
    "precision": 12,
    "scale": 6
   },
   "fx_contract_to_system": {
    "precision": 12,
    "scale": 6
   },
   "mrr_legacy": {
    "precision": 15,
