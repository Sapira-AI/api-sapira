 "mrr_legacy": {
  "comment": "Registro rápido de MRR histórico desde facturas legacy sin reconciliación completa. Una fila = 1 producto + 1 mes. Permite valores negativos para notas de crédito y ajustes.",
  "rls": true,
  "rls_forced": false,
  "columns": {
   "amount_invoice_currency": {
    "precision": 15,
    "scale": 2
