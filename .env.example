# =============================================================================
# API SAPIRA — configuración de entorno
# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
# No agregues secretos reales a este archivo ni lo compartas fuera del equipo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación y red
# -----------------------------------------------------------------------------
# Puerto HTTP donde Nest escucha solicitudes.
PORT=9001
# development | qa | production
NODE_ENV=development
# Zona horaria usada por la conexión MongoDB.
TIMEZONE=America/Santiago
# Orígenes permitidos para CORS y WebSocket del frontend, separados por comas.
FRONT_BASE_URL=http://localhost:8080,http://localhost:8081
# URL pública del front nuevo: los documentos de clientes guardan en file_url <base>/api/documentos/<id>/descargar
# (en producción https://www.aisapira.com). La app actual abre esos enlaces con la sesión compartida.
DOCUMENTS_LINK_BASE_URL=http://localhost:8081
# Versión incluida en telemetría y eventos. Opcional.
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Persistencia
# -----------------------------------------------------------------------------
# MongoDB: almacena auditoría, eventos y datos operacionales.
MONGO_CONNECTION_STRING=mongodb://localhost:27017/sapira
# PostgreSQL de Supabase: conexión server-to-server, nunca exponer al frontend.
# No dejes la URL de producción fija acá: pásala inline en el comando que la necesite.
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Proyectos Supabase por entorno, para que `postgres:assets` verifique que el
# --target declarado corresponde a la base real. El project ref va en el usuario
# (postgres.<ref>) o en el host (db.<ref>.supabase.co). Producción y QA ya están
# declaradas en el código (connection-target.ts); esta variable es solo para un
# proyecto que no sea ninguno de esos dos —no hace falta para operar QA—.
# Entornos válidos: production, qa, development, test.
SUPABASE_PROJECT_ENVIRONMENTS={"your-project-ref":"development"}
#
# Sincronizar el esquema con QA o producción: NO copies este archivo entero.
# Los scripts de esquema (postgres:assets, migration:*, schema:*) solo leen la
# conexión, así que cada entorno tiene un archivo de una línea con
# SUPABASE_DATABASE_URL, ignorado por git: `.env.qa.db` y `.env.prod.db`.
# Las URLs se le piden a Leon. Se cargan así, desde api-sapira/:
#   DOTENV_CONFIG_PATH=.env.qa.db yarn schema:status --target qa
# DOTENV_CONFIG_PATH REEMPLAZA a .env (no lo mezcla), y no sirve para levantar la
# app: el ConfigModule de Nest no la lee. Procedimiento completo:
# src/databases/postgresql/GUIA-CAMBIOS-DE-ESQUEMA.md → "Sincronizar cambios a QA y producción".
# Habilita logs de TypeORM para diagnosticar la conexión SQL.
SUPABASE_LOGGING=false
# Parámetros del pool PostgreSQL.
SUPABASE_POOL_MAX=20
SUPABASE_POOL_MIN=2
SUPABASE_CONNECTION_TIMEOUT=60000
SUPABASE_IDLE_TIMEOUT=300000
SUPABASE_ACQUIRE_TIMEOUT=60000

# -----------------------------------------------------------------------------
# Configuración SII (identidad administrada de Azure)
# -----------------------------------------------------------------------------
# URL del Key Vault que guarda el PFX y su contraseña como un único secreto.
# La identidad administrada de api-sapira necesita el rol Key Vault Secrets Officer.
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# URL del Storage Account y contenedor privado donde se guardan los XML CAF.
# La identidad administrada necesita Storage Blob Data Contributor.
AZURE_STORAGE_ACCOUNT_URL=https://your-storage.blob.core.windows.net
SII_BLOB_CONTAINER=sii-private

# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------
# URL del proyecto Supabase, por ejemplo https://abcxyz.supabase.co.
SUPABASE_URL=https://your-project.supabase.co
# Clave pública/anon. El guard la puede usar para validar el access token.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Opcional: clave server-only para tareas administrativas o verificación.
# No usar en front-sapira ni en variables NEXT_PUBLIC_*.
# Clave service_role: la usa la API para Storage (URLs firmadas del bucket privado client-files). Nunca al front.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Cifrado y proveedores de correo
# -----------------------------------------------------------------------------
# Clave simétrica usada para cifrar secretos almacenados por la API.
ENCRYPTION_KEY=replace-with-a-strong-32-byte-secret
# Resend se utiliza en el módulo de email transaccional.
RESEND_API_KEY=re_your_resend_api_key
# SendGrid se utiliza para envíos masivos y reportes.
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SYSTEM_EMAIL_FROM=no-reply@example.com
SYSTEM_EMAIL_FROM_NAME=Sistema Sapira

# -----------------------------------------------------------------------------
# Integraciones de datos y pagos
# -----------------------------------------------------------------------------
# OBSOLETO: BIGQUERY_CREDENTIALS ya no se usa. Las credenciales de BigQuery se administran
# por holding en la tabla bigquery_connections y se resuelven vía el header x-holding-id.
BIGQUERY_SYNC_ENABLED=true
BIGQUERY_SYNC_HOUR=3
# API key de Anthropic para Sapira Copilot.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Secreto de Stripe para sincronización y operaciones server-side.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_SYNC_ENABLED=true
STRIPE_SYNC_HOUR=2
# Sincronización diaria de staging de Salesforce.
SALESFORCE_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# Indicadores económicos y notificaciones
# -----------------------------------------------------------------------------
BANCO_CENTRAL_USER=your-banco-central-user
BANCO_CENTRAL_PASS=your-banco-central-password
BANCO_CENTRAL_SYNC_ENABLED=false
BANCO_CENTRAL_SYNC_HOUR=8
# Lista separada por comas de destinatarios de alertas.
BANCO_CENTRAL_ADMIN_EMAILS=admin@example.com
BANCO_CENTRAL_SEND_SUCCESS_REPORT=false
# Perú API usa el horario del scheduler de Banco Central, pero se puede desactivar independientemente.
PERU_API_SYNC_ENABLED=true
# Sin clave, solo se omite esta fuente de tipo de cambio.
PERU_API_KEY=your_peru_api_key
PERU_API_BASE_URL=https://peruapi.com/api/tipo_cambio

# -----------------------------------------------------------------------------
# Google reCAPTCHA Enterprise
# -----------------------------------------------------------------------------
# Si faltan estas tres claves, o RECAPTCHA_ENABLED=false, el backend omite la validación.
GOOGLE_RECAPTCHA_API_KEY=
GOOGLE_RECAPTCHA_PROJECT_ID=
GOOGLE_RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENABLED=true

# -----------------------------------------------------------------------------
# Facturación
# -----------------------------------------------------------------------------
FACTURA_API_URL=http://localhost:9005
FACTURA_OAUTH_CLIENT_ID=api-sapira
FACTURA_OAUTH_CLIENT_SECRET=replace-with-a-secret-from-your-secret-manager
FACTURA_OAUTH_SCOPE=factura:empresas:provision
INVOICE_SCHEDULER_ENABLED=false
INVOICE_SCHEDULER_HOUR=9
# Lista separada por comas de destinatarios de reportes de facturación.
INVOICE_ADMIN_EMAILS=admin@example.com
