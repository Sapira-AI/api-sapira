# =============================================================================
# API SAPIRA — configuración de entorno
# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
# No agregues secretos reales a este archivo ni lo compartas fuera del equipo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación y red
# -----------------------------------------------------------------------------
# Puerto HTTP donde Nest escucha solicitudes.
PORT=9001
# development | test | production
NODE_ENV=development
# Zona horaria usada por la conexión MongoDB.
TIMEZONE=America/Santiago
# Origen permitido para CORS y WebSocket del frontend.
FRONT_BASE_URL=http://localhost:8080
# Versión incluida en telemetría y eventos. Opcional.
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Persistencia
# -----------------------------------------------------------------------------
# MongoDB: almacena auditoría, eventos y datos operacionales.
MONGO_CONNECTION_STRING=mongodb://localhost:27017/sapira
# PostgreSQL de Supabase: conexión server-to-server, nunca exponer al frontend.
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Habilita logs de TypeORM para diagnosticar la conexión SQL.
SUPABASE_LOGGING=false
# Parámetros del pool PostgreSQL.
SUPABASE_POOL_MAX=20
SUPABASE_POOL_MIN=2
SUPABASE_CONNECTION_TIMEOUT=60000
SUPABASE_IDLE_TIMEOUT=300000
SUPABASE_ACQUIRE_TIMEOUT=60000

# -----------------------------------------------------------------------------
# Configuración SII (identidad administrada de Azure)
# -----------------------------------------------------------------------------
# URL del Key Vault que guarda el PFX y su contraseña como un único secreto.
# La identidad administrada de api-sapira necesita el rol Key Vault Secrets Officer.
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# URL del Storage Account y contenedor privado donde se guardan los XML CAF.
# La identidad administrada necesita Storage Blob Data Contributor.
AZURE_STORAGE_ACCOUNT_URL=https://your-storage.blob.core.windows.net
SII_BLOB_CONTAINER=sii-private

# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------
# URL del proyecto Supabase, por ejemplo https://abcxyz.supabase.co.
SUPABASE_URL=https://your-project.supabase.co
# Clave pública/anon. El guard la puede usar para validar el access token.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Opcional: clave server-only para tareas administrativas o verificación.
# No usar en front-sapira ni en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Cifrado y proveedores de correo
# -----------------------------------------------------------------------------
# Clave simétrica usada para cifrar secretos almacenados por la API.
ENCRYPTION_KEY=replace-with-a-strong-32-byte-secret
# Resend se utiliza en el módulo de email transaccional.
RESEND_API_KEY=re_your_resend_api_key
# SendGrid se utiliza para envíos masivos y reportes.
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SYSTEM_EMAIL_FROM=no-reply@example.com
SYSTEM_EMAIL_FROM_NAME=Sistema Sapira

# -----------------------------------------------------------------------------
# Integraciones de datos y pagos
# -----------------------------------------------------------------------------
# JSON de una service account de Google BigQuery en una sola línea.
BIGQUERY_CREDENTIALS='{"type":"service_account","project_id":"your-project"}'
BIGQUERY_SYNC_ENABLED=true
BIGQUERY_SYNC_HOUR=3
# API key de Anthropic para Sapira Copilot.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Secreto de Stripe para sincronización y operaciones server-side.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_SYNC_ENABLED=true
STRIPE_SYNC_HOUR=2

# -----------------------------------------------------------------------------
# Indicadores económicos y notificaciones
# -----------------------------------------------------------------------------
BANCO_CENTRAL_USER=your-banco-central-user
BANCO_CENTRAL_PASS=your-banco-central-password
BANCO_CENTRAL_SYNC_ENABLED=false
BANCO_CENTRAL_SYNC_HOUR=8
# Lista separada por comas de destinatarios de alertas.
BANCO_CENTRAL_ADMIN_EMAILS=admin@example.com
BANCO_CENTRAL_SEND_SUCCESS_REPORT=false
# Perú API es opcional; sin clave, solo se omite esa fuente de tipo de cambio.
PERU_API_KEY=your_peru_api_key
PERU_API_BASE_URL=https://peruapi.com/api/tipo_cambio

# -----------------------------------------------------------------------------
# Facturación
# -----------------------------------------------------------------------------
INVOICE_SCHEDULER_ENABLED=false
INVOICE_SCHEDULER_HOUR=9
# Lista separada por comas de destinatarios de reportes de facturación.
INVOICE_ADMIN_EMAILS=admin@example.com
